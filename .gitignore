# Golden-diff images written by a failing visual check. The goldens under
# test/visual/output are committed on purpose; these are the throwaway
# masterImage/testImage/diff triples from whichever run last failed.
test/visual/failures/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing. The keystore and its passwords must never be committed;
# anyone holding both can publish an update as this app.
/android/key.properties
!/android/key.properties.example
*.jks
*.keystore
